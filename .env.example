# ==============================================================================
# GREENSCAPE PRO AI PROPOSAL ENGINE (.env.example)
# ==============================================================================

# LLM API Providers (OpenAI or Anthropic)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
LLM_MODEL=gpt-4o # Options: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022

# Persistent Database (Supabase / Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# GoHighLevel (GHL) Integration
GHL_API_KEY=your-ghl-api-key-here
GHL_LOCATION_ID=your-ghl-location-id-here
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-webhook-id

# Slack Webhook Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX
SLACK_CARLOS_CHANNEL_WEBHOOK=https://hooks.slack.com/services/T000/B000/YYYYY

# Stripe Payments & Deposit Invoicing
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio SMS / Email Notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+16025550199

# App Configuration
NEXT_PUBLIC_APP_URL=https://greenscape-autoquote.vercel.app
NEXT_PUBLIC_COMPANY_NAME="Greenscape Pro"
NEXT_PUBLIC_COMPANY_LOCATION="Phoenix, AZ"
DEFAULT_TARGET_MARGIN=0.38
CARLOS_RENDER_THRESHOLD=30000
